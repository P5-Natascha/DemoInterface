# Testserver auf demselben Rechner:   host.docker.internal
# Echtes Auto:                        die IP des Autos, z. B. 192.168.4.1
CAR_IP=host.docker.internal
# Öffentliche Adresse der Steuerungsseite (Port 8080), wird im QR-Code verwendet
PUBLIC_URL=https://car.example.com
# Optional: nur der Startwert für den allerersten Key. Danach verwaltet ihn das Admin-Panel.
CONTROL_TOKEN=
# Admin-Port nur lokal (Standard). Liegt Pangolin in einem anderen Netz: 0.0.0.0, dann per Firewall absichern.
# ADMIN_BIND=127.0.0.1

# --- Kameras (MJPEG-Stream des Autos, eigener Port, unabhängig von 9005/9006) ---
# Rechner der Kameras; leer = gleicher wie CAR_IP
CAMERA_HOST=
CAMERA_PORT=5000
CAMERA_FRONT_PATH=/camera/front_feed
CAMERA_BACK_PATH=/camera/back_feed
# Optional: komplette URLs statt Host/Port/Pfad (haben Vorrang)
# CAMERA_FRONT_URL=http://192.168.4.1:81/camera/front_feed
# CAMERA_BACK_URL=http://192.168.4.1:81/camera/back_feed
# 1 = Kamerabild nur mit gültigem Zugangsschlüssel (Standard 0: jeder, der die Seite öffnet, sieht es)
CAMERA_REQUIRE_KEY=0
