# Testserver auf demselben Rechner:   host.docker.internal
# Echtes Auto:                        die IP des Autos, z. B. 192.168.4.1
CAR_IP=host.docker.internal
# Öffentliche Adresse der Steuerungsseite (Port 8080), wird im QR-Code verwendet
PUBLIC_URL=https://car.example.com
# Optional: nur der Startwert für den allerersten Key. Danach verwaltet ihn das Admin-Panel.
CONTROL_TOKEN=
# Admin-Port nur lokal (Standard). Liegt Pangolin in einem anderen Netz: 0.0.0.0, dann per Firewall absichern.
# ADMIN_BIND=127.0.0.1
